    "sync:lib": "node scripts/sync-lib.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
